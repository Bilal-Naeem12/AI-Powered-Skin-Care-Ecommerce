NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/skincare
# Optional comma-separated DNS server IPs; leave blank to use Node's default.
MONGODB_DNS_SERVERS=
# Use a disposable database only; legacy integration tests DROP this database.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/skincare_test
JWT_SECRET=
JWT_REFRESH_SECRET=
PROGRESS_HASH_SECRET=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Use the Brevo SMTP login and SMTP key, NOT an API key or account password.
SMTP_USER=
SMTP_PASS=
# A sender verified in Brevo; separate from the SMTP login.
EMAIL_FROM=
EMAIL_FROM_NAME="SkinCare Pro"
# Inbox receiving contact form notifications (defaults to EMAIL_FROM).
CONTACT_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
FILE_SIZE=5242880
